{% extends 'pdf/layout.html.twig' %}

{% block title %}{{ 'intervention.title'|trans({ '%number%': number }, 'pdf', lang) }}{% endblock %}

{% block headerTitle %}{{ 'intervention.title'|trans({ '%number%': number }, 'pdf', lang) }}{% endblock %}

{% block styles %}
    .label-chip { display: inline-block; padding: 1px 6px; margin-right: 4px; border-radius: 3px; border: 1px solid #cbd2d9; font-size: 8px; }
    .severity-blocker { color: #b3261e; font-weight: bold; }
    .severity-warning { color: #9a6700; font-weight: bold; }
    .severity-recommendation { color: #52606d; font-weight: bold; }
{% endblock %}

{% block content %}
  <h1>{{ 'intervention.title'|trans({ '%number%': number }, 'pdf', lang) }}</h1>
  <div class="meta">
    <table>
      <tr>
        <td class="meta-label">{{ 'intervention.meta.name'|trans({}, 'pdf', lang) }}</td>
        <td>{{ name }}</td>
      </tr>
      <tr>
        <td class="meta-label">{{ 'intervention.meta.type'|trans({}, 'pdf', lang) }}</td>
        <td>{{ type }}</td>
      </tr>
      <tr>
        <td class="meta-label">{{ 'intervention.meta.status'|trans({}, 'pdf', lang) }}</td>
        <td>{{ status }}</td>
      </tr>
      <tr>
        <td class="meta-label">{{ 'intervention.meta.priority'|trans({}, 'pdf', lang) }}</td>
        <td>{{ priority }}</td>
      </tr>
      <tr>
        <td class="meta-label">{{ 'intervention.meta.site'|trans({}, 'pdf', lang) }}</td>
        <td>{{ siteName|default('—') }}</td>
      </tr>
      <tr>
        <td class="meta-label">{{ 'intervention.meta.responsible'|trans({}, 'pdf', lang) }}</td>
        <td>{{ responsibleName|default('—') }}</td>
      </tr>
      <tr>
        <td class="meta-label">{{ 'intervention.meta.participants'|trans({}, 'pdf', lang) }}</td>
        <td>{{ participantNames is not empty ? participantNames|join(', ') : '—' }}</td>
      </tr>
      <tr>
        <td class="meta-label">{{ 'intervention.meta.plannedStart'|trans({}, 'pdf', lang) }}</td>
        <td>{{ plannedStartAt|default('—') }}</td>
      </tr>
      <tr>
        <td class="meta-label">{{ 'intervention.meta.due'|trans({}, 'pdf', lang) }}</td>
        <td>{{ dueAt|default('—') }}</td>
      </tr>
      {% if reviewNote is not empty %}
        <tr>
          <td class="meta-label">{{ 'intervention.meta.reviewNote'|trans({}, 'pdf', lang) }}</td>
          <td>{{ reviewNote }}</td>
        </tr>
      {% endif %}
      <tr>
        <td class="meta-label">{{ 'intervention.meta.signature'|trans({}, 'pdf', lang) }}</td>
        <td>{{ (hasSignature ? 'common.yes' : 'common.no')|trans({}, 'pdf', lang) }}</td>
      </tr>
      {% if labels is not empty %}
        <tr>
          <td class="meta-label">{{ 'intervention.meta.labels'|trans({}, 'pdf', lang) }}</td>
          <td>
            {% for label in labels %}
              <span class="label-chip">{{ label.name }}</span>
            {% endfor %}
          </td>
        </tr>
      {% endif %}
      <tr>
        <td class="meta-label">{{ 'intervention.meta.generatedAt'|trans({}, 'pdf', lang) }}</td>
        <td>{{ generatedAtFormatted }}</td>
      </tr>
    </table>
  </div>

  <h2>{{ 'intervention.workItems.heading'|trans({}, 'pdf', lang) }}</h2>
  {% if workItems is empty %}
    <p class="empty">{{ 'intervention.workItems.empty'|trans({}, 'pdf', lang) }}</p>
  {% else %}
    <table class="data">
      <tr>
        <th>{{ 'intervention.workItems.action'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.workItems.target'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.workItems.assignee'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.workItems.status'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.workItems.required'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.workItems.skipReason'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.workItems.evidence'|trans({}, 'pdf', lang) }}</th>
      </tr>
      {% for workItem in workItems %}
        <tr>
          <td>{{ workItem.action }}</td>
          <td>{{ workItem.target }}</td>
          <td>{{ workItem.assigneeName|default('—') }}</td>
          <td>{{ workItem.status }}</td>
          <td>{{ (workItem.required ? 'common.yes' : 'common.no')|trans({}, 'pdf', lang) }}</td>
          <td>{{ workItem.skipReason|default('—') }}</td>
          <td>{{ workItem.evidenceCount }}</td>
        </tr>
      {% endfor %}
    </table>
  {% endif %}

  <h2>{{ 'intervention.issues.heading'|trans({}, 'pdf', lang) }}</h2>
  {% if issues is empty %}
    <p class="empty">{{ 'intervention.issues.empty'|trans({}, 'pdf', lang) }}</p>
  {% else %}
    <table class="data">
      <tr>
        <th>{{ 'intervention.issues.severity'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.issues.message'|trans({}, 'pdf', lang) }}</th>
      </tr>
      {% for issue in issues %}
        <tr>
          <td class="severity-{{ issue.severity }}">{{ ('intervention.severity.' ~ issue.severity)|trans({}, 'pdf', lang) }}</td>
          <td>{{ issue.message }}</td>
        </tr>
      {% endfor %}
    </table>
  {% endif %}

  <h2>{{ 'intervention.changes.heading'|trans({}, 'pdf', lang) }}</h2>
  <table class="data">
    <tr>
      <th>{{ 'intervention.changes.proposed'|trans({}, 'pdf', lang) }}</th>
      <th>{{ 'intervention.changes.applied'|trans({}, 'pdf', lang) }}</th>
      <th>{{ 'intervention.changes.rejected'|trans({}, 'pdf', lang) }}</th>
    </tr>
    <tr>
      <td>{{ proposedChangesCount }}</td>
      <td>{{ appliedChangesCount }}</td>
      <td>{{ rejectedChangesCount }}</td>
    </tr>
  </table>

  <h2>{{ 'intervention.attachments.heading'|trans({}, 'pdf', lang) }}</h2>
  {% if attachments is empty %}
    <p class="empty">{{ 'intervention.attachments.empty'|trans({}, 'pdf', lang) }}</p>
  {% else %}
    <table class="data">
      <tr>
        <th>{{ 'intervention.attachments.fileName'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.attachments.kind'|trans({}, 'pdf', lang) }}</th>
      </tr>
      {% for attachment in attachments %}
        <tr>
          <td>{{ attachment.fileName }}</td>
          <td>{{ attachment.kind }}</td>
        </tr>
      {% endfor %}
    </table>
  {% endif %}

  <h2>{{ 'intervention.activities.heading'|trans({}, 'pdf', lang) }}</h2>
  {% if activities is empty %}
    <p class="empty">{{ 'intervention.activities.empty'|trans({}, 'pdf', lang) }}</p>
  {% else %}
    <table class="data">
      <tr>
        <th>{{ 'intervention.activities.date'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.activities.kind'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.activities.event'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.activities.actor'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'intervention.activities.comment'|trans({}, 'pdf', lang) }}</th>
      </tr>
      {% for activity in activities %}
        <tr>
          <td>{{ activity.createdAt|default('—') }}</td>
          <td>{{ activity.kind }}</td>
          <td>{{ activity.event }}</td>
          <td>{{ activity.actorName|default('—') }}</td>
          <td>{{ activity.body|default('—') }}</td>
        </tr>
      {% endfor %}
    </table>
  {% endif %}

  <div class="doc-note">
    {{ 'intervention.note'|trans({}, 'pdf', lang) }}
  </div>
{% endblock %}
