{% extends 'pdf/layout.html.twig' %}

{% block title %}{{ 'compliance.title'|trans({}, 'pdf', lang) }}{% endblock %}

{% block headerTitle %}{{ 'compliance.title'|trans({}, 'pdf', lang) }}{% endblock %}

{% block styles %}
    .status-compliant { color: #1a7f37; font-weight: bold; }
    .status-at_risk { color: #9a6700; font-weight: bold; }
    .status-non_compliant { color: #b3261e; font-weight: bold; }
    .status-not_applicable { color: #52606d; font-weight: bold; }
{% endblock %}

{% block content %}
  <h1>
    {{ 'compliance.title'|trans({}, 'pdf', lang) }} —
    {{ (scope == 'facility' ? 'compliance.scope.facility' : 'compliance.scope.organization')|trans({}, 'pdf', lang) }}
  </h1>
  <div class="meta">
    <table>
      <tr>
        <td class="meta-label">{{ 'compliance.meta.generatedAt'|trans({}, 'pdf', lang) }}</td>
        <td>{{ generatedAtFormatted }}</td>
      </tr>
      <tr>
        <td class="meta-label">{{ 'compliance.meta.organization'|trans({}, 'pdf', lang) }}</td>
        <td>{{ org.name }}</td>
      </tr>
      {% if facilityId is not empty %}
        <tr>
          <td class="meta-label">{{ 'compliance.meta.facility'|trans({}, 'pdf', lang) }}</td>
          <td>{{ facilityId }}</td>
        </tr>
      {% endif %}
      <tr>
        <td class="meta-label">{{ 'compliance.meta.plan'|trans({}, 'pdf', lang) }}</td>
        <td>{{ planKey|default('unknown') }}</td>
      </tr>
      {% if organizationStatus is defined %}
        <tr>
          <td class="meta-label">{{ 'compliance.meta.overallStatus'|trans({}, 'pdf', lang) }}</td>
          <td><span class="status-{{ organizationStatus }}">{{ ('compliance.status.' ~ organizationStatus)|trans({}, 'pdf', lang) }}</span></td>
        </tr>
      {% endif %}
    </table>
  </div>

  {% if totals is defined and totals is not empty %}
    <h2>{{ 'compliance.totals.heading'|trans({}, 'pdf', lang) }}</h2>
    <table class="data">
      <tr>
        <th>{{ 'compliance.totals.equipmentTotal'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'compliance.totals.upToDate'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'compliance.totals.dueSoon'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'compliance.totals.overdue'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'compliance.totals.unscheduled'|trans({}, 'pdf', lang) }}</th>
        <th>{{ 'compliance.totals.openNonConformities'|trans({}, 'pdf', lang) }}</th>
      </tr>
      <tr>
        <td>{{ totals.totalEquipmentCount }}</td>
        <td>{{ totals.upToDateEquipmentCount }}</td>
        <td>{{ totals.dueSoonEquipmentCount }}</td>
        <td>{{ totals.overdueEquipmentCount }}</td>
        <td>{{ totals.unscheduledEquipmentCount }}</td>
        <td>{{ totals.openLowNonConformityCount }} / {{ totals.openMediumNonConformityCount }} / {{ totals.openHighNonConformityCount }} / {{ totals.openCriticalNonConformityCount }}</td>
      </tr>
    </table>
  {% endif %}

  <h2>{{ 'compliance.facilities.heading'|trans({}, 'pdf', lang) }}</h2>
  <table class="data">
    <tr>
      <th>{{ 'compliance.facilities.facility'|trans({}, 'pdf', lang) }}</th>
      <th>{{ 'compliance.facilities.type'|trans({}, 'pdf', lang) }}</th>
      <th>{{ 'compliance.facilities.status'|trans({}, 'pdf', lang) }}</th>
      <th>{{ 'compliance.facilities.equipment'|trans({}, 'pdf', lang) }}</th>
      <th>{{ 'compliance.facilities.openNonConformities'|trans({}, 'pdf', lang) }}</th>
      <th>{{ 'compliance.facilities.lastInspection'|trans({}, 'pdf', lang) }}</th>
    </tr>
    {% for facility in facilities %}
      <tr>
        <td>{{ facility.path }}</td>
        <td>{{ facility.type }}</td>
        <td class="status-{{ facility.status }}">{{ ('compliance.status.' ~ facility.status)|trans({}, 'pdf', lang) }}</td>
        <td>{{ facility.upToDateEquipmentCount }} / {{ facility.dueSoonEquipmentCount }} / {{ facility.overdueEquipmentCount }} / {{ facility.unscheduledEquipmentCount }}</td>
        <td>{{ facility.openLowNonConformityCount }} / {{ facility.openMediumNonConformityCount }} / {{ facility.openHighNonConformityCount }} / {{ facility.openCriticalNonConformityCount }}</td>
        <td>{{ facility.lastInspectionAt|default('—') }}</td>
      </tr>
    {% endfor %}
  </table>

  <div class="doc-note">
    {{ 'compliance.note'|trans({ '%date%': generatedAtFormatted }, 'pdf', lang) }}
  </div>
{% endblock %}
