{% extends 'notification/email/layout.html.twig' %}
{% import 'notification/email/components.html.twig' as ui %}

{% set lang = locale|default('en') %}

{% block lang %}{{ lang }}{% endblock %}

{% block content %}
  <h1>{{ 'emailChange.confirmHeading'|trans({}, 'emails', lang) }}</h1>
  <p>{{ 'emailChange.confirmIntro'|trans({}, 'emails', lang) }}</p>
  {{ ui.button(confirmUrl, 'emailChange.confirmCta'|trans({}, 'emails', lang)) }}
  {{ ui.linkFallback('emailChange.confirmFallback'|trans({}, 'emails', lang), confirmUrl) }}
  <p class="muted">
    {{ 'emailChange.confirmExpires'|trans({ '%date%': expiresAt }, 'emails', lang) }}
  </p>
  <p class="muted">{{ 'emailChange.confirmIgnore'|trans({}, 'emails', lang) }}</p>
  {% include 'notification/email/request_location.html.twig' %}
{% endblock %}
