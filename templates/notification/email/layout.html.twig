{# Common layout for transactional emails.

   Visual language mirrors the web app (fireguard-web DESIGN.md): neutral zinc ramp,
   flat white canvas (no card around the message), vermilion primary used as a *fill*
   only (button, brand mark), neutral underlined links, hairline separators, and a dark
   scheme that follows `prefers-color-scheme` (Apple Mail and other clients that support it).

   Cards hold the *content* of a notification, never the text around it: the OTP code tile,
   the request details card, the notification body card and the digest item cards. They are
   tinted like the app's page header, `bg-muted/25`: #fcfcfc on white, #111113 on the dark
   canvas.
   Hex values are the sRGB conversions of the `src/styles.css` oklch tokens.

   Structure is table-based on purpose: Outlook (Word engine) ignores `max-width`
   on divs, and Gmail clips unknown layout. Colors live in classes so the dark
   scheme can override them without `!important`; the only inline fallbacks are
   `bgcolor` attributes, which every class rule outranks.

   The brand mark is referenced as `cid:fireguard-mark`: the mailer embeds the PNG
   next to this template (`EmbedBrandMarkSubscriber`). Remote images are blocked by
   default in many clients and data: URIs are stripped by Gmail, so neither is used.

   Optional context: `lang` (set by the child template; falls back to `en`). #}
<!DOCTYPE html>
<html lang="{% block lang %}en{% endblock %}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>{% block title %}{{ subject|default('Fireguard') }}{% endblock %}</title>
    <style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      body { margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; background-color: #ffffff; color: #09090b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }
      table { border-collapse: collapse; }
      img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
      .wrapper { background-color: #ffffff; }
      .container { width: 100%; max-width: 560px; background-color: #ffffff; }
      .header { padding: 8px 0 0; }
      .brand { padding-left: 10px; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; line-height: 26px; color: #09090b; }
      .content { padding: 28px 0 8px; color: #09090b; font-size: 15px; line-height: 1.6; }
      .content h1 { margin: 0 0 16px; font-size: 22px; font-weight: 600; line-height: 1.25; letter-spacing: -0.02em; color: #09090b; }
      .content p, .prose p { margin: 0 0 16px; font-size: 15px; line-height: 1.6; color: #09090b; }
      .content ul, .prose ul { margin: 0 0 16px; padding-left: 20px; }
      .content li, .prose li { margin: 0 0 4px; font-size: 15px; line-height: 1.6; color: #09090b; }
      .content a, .prose a { color: #09090b; text-decoration: underline; }
      .muted { color: #71717b !important; font-size: 13px !important; line-height: 1.5 !important; }
      .btn-wrap { margin: 8px 0 24px; }
      .btn-cell { background-color: #f4511e; border-radius: 8px; }
      .content a.btn { display: inline-block; padding: 12px 24px; font-size: 15px; font-weight: 600; line-height: 1.2; color: #ffffff !important; text-decoration: none; }
      .content .link-fallback { margin: 0 0 16px; font-size: 13px; line-height: 1.5; word-break: break-all; }
      .content .link-fallback a { color: #09090b; text-decoration: underline; }
      .details { width: 100%; margin: 0 0 24px; border-top: 1px solid #e4e4e7; }
      .details td { padding: 10px 0; border-bottom: 1px solid #e4e4e7; font-size: 13px; line-height: 1.5; color: #09090b; }
      .details td.label { width: 38%; color: #71717b; }
      .code { margin: 8px 0 24px; padding: 20px 16px; background-color: #fcfcfc; border: 1px solid #e4e4e7; border-radius: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace; font-size: 32px; font-weight: 600; line-height: 1.2; letter-spacing: 0.4em; text-indent: 0.4em; text-align: center; color: #09090b; }
      .details-card { width: 100%; margin: 0 0 24px; background-color: #fcfcfc; border: 1px solid #e4e4e7; border-collapse: separate; border-radius: 8px; }
      .details-card td { padding: 7px 16px; font-size: 14px; line-height: 1.5; color: #09090b; }
      .details-card tr:first-child td { padding-top: 16px; }
      .details-card tr:last-child td { padding-bottom: 16px; }
      .details-card td.label { width: 40%; color: #71717b; }
      .section { margin: 28px 0 0; }
      .section-title { font-size: 14px; font-weight: 600; line-height: 24px; color: #09090b; }
      .item-card { width: 100%; margin: 10px 0 0; background-color: #fcfcfc; border: 1px solid #e4e4e7; border-collapse: separate; border-radius: 8px; }
      .item-card td { padding: 12px 16px; border-top: 1px solid #e4e4e7; font-size: 14px; line-height: 1.5; color: #09090b; vertical-align: top; }
      .item-card tr:first-child td { border-top: 0; }
      .item-card td.side { padding-left: 8px; text-align: right; white-space: nowrap; }
      .item-card .prose p { margin: 0 0 10px; font-size: 14px; }
      .item-card .prose p:last-child { margin-bottom: 0; }
      .sub { display: block; font-size: 13px; color: #71717b; }
      .ref { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace; font-size: 13px; color: #71717b; }
      /* Badges mirror the app's hlmBadge: 20px pill, 12px/500 text, 1px border. Status badges are the
         `outline` variant with muted text where only the dot carries the tone (the app colours the icon,
         not the ground); counts use `secondary`; the single alert fill is the `destructive` variant. */
      .badge { display: inline-block; padding: 0 8px; border: 1px solid #e4e4e7; border-radius: 999px; font-size: 12px; font-weight: 500; line-height: 18px; white-space: nowrap; color: #71717b; }
      .badge .dot { display: inline-block; width: 6px; height: 6px; margin-right: 5px; border-radius: 50%; background-color: #a1a1aa; vertical-align: middle; position: relative; top: -1px; }
      .dot-success { background-color: #009966 !important; }
      .dot-warning { background-color: #e17100 !important; }
      .dot-info { background-color: #0092b8 !important; }
      .dot-destructive { background-color: #e7000b !important; }
      .badge-secondary { background-color: #f4f4f5; border-color: #f4f4f5; color: #18181b; }
      .badge-destructive { background-color: #fde6e7; border-color: #fde6e7; color: #c4000a; }
      .footer { padding: 20px 0 0; border-top: 1px solid #e4e4e7; font-size: 12px; line-height: 1.5; color: #71717b; }
      .footer p { margin: 0; }
      @media (max-width: 600px) {
        .wrapper-cell { padding: 24px 20px !important; }
        .code { font-size: 28px !important; letter-spacing: 0.3em !important; text-indent: 0.3em !important; }
        .details-card td { padding-left: 14px !important; padding-right: 14px !important; }
      }
      @media (prefers-color-scheme: dark) {
        body, .wrapper, .container { background-color: #09090b !important; }
        .footer, .details, .details td { border-color: #27272a !important; }
        .code, .details-card, .item-card { background-color: #111113 !important; border-color: #222224 !important; }
        .item-card td { border-color: #222224 !important; }
        .brand, .content, .content h1, .content p, .prose p, .content li, .prose li, .content a, .prose a, .content .link-fallback a, .details td, .details-card td, .item-card td, .section-title, .code { color: #fafafa !important; }
        .muted, .content .muted, .content p.muted, .details td.label, .details-card td.label, .sub, .ref, .footer { color: #a1a1aa !important; }
        .btn-cell { background-color: #ff7043 !important; }
        .content a.btn { color: #0a0a0a !important; }
        .badge { border-color: #222223 !important; color: #a0a0aa !important; }
        .dot-success { background-color: #35d399 !important; }
        .dot-warning { background-color: #fbbf25 !important; }
        .dot-info { background-color: #21d3ee !important; }
        .dot-destructive { background-color: #ff6467 !important; }
        .badge .dot-muted { background-color: #71717a !important; }
        .badge-secondary { background-color: #262629 !important; border-color: #262629 !important; color: #fafafa !important; }
        .badge-destructive { background-color: #3a1b1d !important; border-color: #3a1b1d !important; color: #ff6467 !important; }
      }
    </style>
  </head>
  <body>
    <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" class="wrapper" bgcolor="#ffffff">
      <tr>
        <td align="center" class="wrapper-cell" style="padding: 40px 24px;">
          <table role="presentation" width="560" border="0" cellpadding="0" cellspacing="0" class="container" bgcolor="#ffffff">
            <tr>
              <td class="header">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="vertical-align: middle;"><img src="cid:fireguard-mark" width="31" height="25" alt="" style="display: block;" /></td>
                    <td class="brand" style="vertical-align: middle;">Fireguard</td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td class="content">
                {% block content %}{% endblock %}
              </td>
            </tr>
            <tr>
              <td class="footer">
                {% block footer %}
                  <p>{{ 'layout.footer'|trans({}, 'emails', lang|default('en')) }}</p>
                {% endblock %}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
