{% extends 'notification/email/layout.html.twig' %}

{% block content %}
  <h1>{{ subject }}</h1>
  <p>{{ instruction }}</p>
  <div style="font-size:32px;font-weight:700;letter-spacing:8px;color:#ea580c;text-align:center;padding:20px;background:#f1f5f9;border-radius:8px;margin:24px 0;">{{ code }}</div>
  <p>This code expires in <strong>{{ expiresInMinutes }} minutes</strong>.</p>
  <p class="muted">If you didn't request this code, please ignore this email.</p>
{% endblock %}
