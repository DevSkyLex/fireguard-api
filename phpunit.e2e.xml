<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<!--
    E2E-only config, split out from phpunit.dist.xml.

    Runs against the seeded `fireguard_*_e2e` databases (created once by the
    CI workflow) rather than the `fireguard_*_test` ones `make test-db` builds
    locally, so CI can keep an E2E-only baseline separate from the databases
    the other suites share. Both baselines are seeded the same way; the E2E
    suite also runs under phpunit.dist.xml against `fireguard_*_test`.

    tests/bootstrap.php clones whichever pair is configured into a private
    copy per run, keyed by TEST_TOKEN, so the exact-count assertions in
    tests/E2E cannot be moved by anything outside the run.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnPhpunitDeprecation="true"
         failOnPhpunitNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         executionOrder="random"
         resolveDependencies="true"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <ini name="memory_limit" value="2G" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="APP_DEBUG" value="0" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled" />
        <env name="MFA_ENABLED" value="false" />
        <env name="KERNEL_CLASS" value="App\Kernel" />

        <!--
            Local defaults for a bare `paratest -c phpunit.e2e.xml` outside CI.
            A real environment variable (CI, or an exported shell one) wins over
            both these and the `.env.test` values, since Dotenv never overwrites
            an already-set variable.
        -->
        <env name="AUTH_DATABASE_URL" value="postgresql://admin:!ChangeMe!@127.0.0.1:5433/fireguard_auth_e2e?serverVersion=16&amp;charset=utf8" />
        <env name="MAIN_DATABASE_URL" value="postgresql://main_admin:!ChangeMeMain!@127.0.0.1:5434/fireguard_main_e2e?serverVersion=16&amp;charset=utf8" />
    </php>

    <testsuites>
        <testsuite name="E2E Tests">
            <directory>tests/E2E</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory suffix="Resource.php">src</directory>
        </exclude>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <coverage>
        <report>
            <clover outputFile="var/coverage/e2e.xml"/>
            <text outputFile="var/coverage/e2e.txt" showOnlySummary="true"/>
        </report>
    </coverage>

    <extensions>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
        <bootstrap class="Symfony\Bridge\PhpUnit\SymfonyExtension">
            <parameter name="clock-mock-namespaces" value="App" />
            <parameter name="dns-mock-namespaces" value="App" />
        </bootstrap>
    </extensions>
</phpunit>
