###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
AUTH_DATABASE_URL="postgresql://user:password@127.0.0.1:5432/db_fireguard_auth?serverVersion=16&charset=utf8"
MAIN_DATABASE_URL="postgresql://main_user:password@127.0.0.1:5432/db_fireguard_main?serverVersion=16&charset=utf8"
DATABASE_STORAGE_TIMEZONE=UTC
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# `auth` is the only registered default connection (doctrine.yaml declares
# `auth` and `main`); `doctrine://default` throws at dispatch time. Keep this a
# real transport — `in-memory://` belongs in .env.test, where `when@test`
# already forces it, and here it silently discards every async command.
MESSENGER_TRANSPORT_DSN=doctrine://auth?auto_setup=0
###< symfony/messenger ###

###> symfony/cache ###
REDIS_URL=redis://redis:6379
###< symfony/cache ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/mercure-bundle ###
MERCURE_URL=http://localhost/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost/.well-known/mercure
MERCURE_JWT_SECRET=change_me
MERCURE_CORS_ORIGINS=http://localhost:4200
###< symfony/mercure-bundle ###

###> oauth2 ###
OAUTH_ISSUER=http://localhost:8000
OAUTH_ENCRYPTION_KEY=change_me
# Token TTL configuration (in seconds)
ACCESS_TOKEN_TTL=3600
# Access token claim inclusion (true/false). Set to true to maintain backward compatibility with external consumers.
ACCESS_TOKEN_INCLUDE_EMAIL=true
ACCESS_TOKEN_INCLUDE_RBAC=true
# Refresh token cookie configuration
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_LIFETIME_SHORT=86400
REFRESH_TOKEN_LIFETIME_LONG=2592000
# Token cache TTL (in seconds)
TOKEN_CACHE_TTL=300
# RBAC permission cache TTL (in seconds)
AUTHZ_PERMISSION_CACHE_TTL=60
# Trusted device cookie configuration
TRUSTED_DEVICE_COOKIE_NAME=trusted_device
TRUSTED_DEVICE_LIFETIME=2592000
# Cookie security override (true/false). When unset, defaults to APP_ENV=prod.
COOKIE_SECURE=
###< oauth2 ###

# Security log PII handling (true/false)
SECURITY_LOG_INCLUDE_PII=false
# Optional salt for hashing PII in logs
SECURITY_LOG_PII_SALT=

# Data retention (days) for cleanup command
DATA_RETENTION_DAYS=90

MFA_ENABLED=false
# OTP challenge code length (SMS/Email)
OTP_CODE_LENGTH=6
# TOTP code length (authenticator app). Changing this will invalidate existing TOTP enrollments.
TOTP_DIGITS=6
ADMIN_EMAIL='admin@test.local'
SMS_DSN='null://null'
MAILER_FROM='no-reply@test.local'
CORS_ALLOW_ORIGIN='http://localhost:4200'
# DEFAULT_URI is declared once, at the top of this file. Redeclaring it here
# silently won and flipped the scheme to https.

###> webhook ###
# Reversible AES-256-GCM key for the webhook signing secret at rest (base64-encoded 32 raw bytes)
WEBHOOK_ENCRYPTION_KEY=change_me
# Allow plain http:// webhook target URLs (dev/local only — never in prod)
WEBHOOK_ALLOW_INSECURE_URLS=false
# Outbound delivery request timeout, in seconds
WEBHOOK_HTTP_TIMEOUT=10
###< webhook ###

###> assistant ###
# Ollama server base URL (operator configuration only — no tenant setting can ever redirect inference traffic).
# The app runs INSIDE a container while Ollama runs on the host, so `localhost`
# would resolve to the container itself. Verified from inside the app container:
#   http://localhost:11434              -> unreachable
#   http://host.docker.internal:11434   -> {"version":"0.20.7"}
# Docker Desktop resolves host.docker.internal natively (no extra_hosts needed).
# On a host where Ollama is NOT reachable from Docker, set OLLAMA_HOST=0.0.0.0 on
# the Ollama side — it binds 127.0.0.1 by default.
# Use http://localhost:11434 only when running the app outside the container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Outbound generation request timeout, in seconds. Generous on purpose: the first
# call after a cold start also pays the model load (measured ~256 ms load + ~40 ms
# for 8 tokens on gemma4:e4b once warm, but a 24 GB model loads far slower).
OLLAMA_HTTP_TIMEOUT=120
# Default model served when an organization has no per-organization override
OLLAMA_DEFAULT_MODEL=gemma4:e4b
# Comma-separated allowlist of model identifiers organizations may select.
# NOT cosmetic: an Ollama host commonly also serves models that are useless or
# harmful here — a translation model, or an image-generation model. The allowlist
# is what stops an organization pointing its assistant at one.
OLLAMA_ALLOWED_MODELS=gemma4:e4b,qwen3.6:latest
###< assistant ###

###> stripe/stripe-php ###
# Stripe API secret key (sk_test_... in test mode)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# ISO currency code used for display pricing
STRIPE_CURRENCY=eur
# Public frontend base URL used to build Checkout/Portal return links
APP_FRONTEND_URL=http://localhost:4200
# Recurring Stripe price ids per plan and cadence
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=
# Display amounts in the currency's smallest unit (e.g. cents)
STRIPE_PRICE_PRO_MONTHLY_AMOUNT=0
STRIPE_PRICE_PRO_YEARLY_AMOUNT=0
STRIPE_PRICE_MAX_MONTHLY_AMOUNT=0
STRIPE_PRICE_MAX_YEARLY_AMOUNT=0
###< stripe/stripe-php ###



