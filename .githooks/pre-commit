#!/bin/sh
#
# Format the staged PHP files, then re-stage them.
#
# Scoped to the staged files on purpose: running the fixer over the whole tree
# would drag unrelated formatting into the commit. Note that this rewrites what
# you are committing — if you stage part of a file with `git add -p`, the fixer
# still reformats the whole file, and the reformatted remainder gets staged too.
#
# Enable with:  git config core.hooksPath .githooks
# Bypass with:  git commit --no-verify
set -e

[ -f vendor/bin/php-cs-fixer ] || exit 0

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')

[ -z "$staged" ] && exit 0

# --sequential overrides the parallel runner the config enables. Spreading a
# handful of staged files over 31 processes costs more in spawning than it saves:
# measured 4.5s parallel against 3.1s sequential on ~100 files. The parallel
# runner is there for the cold full-tree run (CI), not for this.
printf '%s' "$staged" | tr '\n' '\0' | xargs -0 -r \
  php -d memory_limit=1G vendor/bin/php-cs-fixer fix \
  --config=.php-cs-fixer.dist.php \
  --path-mode=intersection \
  --sequential \
  --quiet \
  --

printf '%s' "$staged" | tr '\n' '\0' | xargs -0 -r git add --
