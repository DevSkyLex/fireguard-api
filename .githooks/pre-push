#!/bin/sh
#
# Whole-project checks, run once per push rather than once per commit.
#
# PHPStan and deptrac cannot be scoped to the changed files — an edit in one
# class surfaces errors in another — so they always analyse everything. That
# costs ~7s warm and ~35s cold, which is tolerable per push but would train
# everyone to reach for --no-verify if it ran on every commit.
#
# This is fast feedback, not a guarantee: CI runs the same checks on every PR.
#
# Enable with:  git config core.hooksPath .githooks
# Bypass with:  git push --no-verify
set -e

# Branch names, from the refs git feeds on stdin as
# `<local ref> <local sha> <remote ref> <remote sha>`. Checked here rather than at
# creation time because a hook cannot run on `git checkout -b`, and because a name
# that never leaves the machine harms nobody.
#
# `claude/*` is exempt: those branches are generated by Claude Code (sessions, cloud
# runs, worktrees), so rejecting them would fight the tool that produced them.
branch_pattern='^(feat|fix|chore|refactor|docs|test|perf|ci|build|style|revert|hotfix)/[a-z0-9]+(-[a-z0-9]+)*$'
branch_exempt='^(main|develop|claude/.+|release/[0-9]+\.[0-9]+\.[0-9]+)$'

while read -r local_ref local_sha _rest; do
  # An all-zero sha is a deletion: no name to validate.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  branch=${local_ref#refs/heads/}
  [ "$branch" = "$local_ref" ] && continue

  printf '%s' "$branch" | grep -Eq "$branch_exempt" && continue
  if ! printf '%s' "$branch" | grep -Eq "$branch_pattern"; then
    echo "Rejected: branch name \"$branch\"" >&2
    echo '' >&2
    echo 'Expected <type>/<description-kebab>, e.g. feat/organization-invitations' >&2
    echo 'Type:    feat fix chore refactor docs test perf ci build style revert hotfix' >&2
    echo 'Rename:  git branch -m <new-name>   (then push again)' >&2
    exit 1
  fi
done

[ -f vendor/bin/phpstan ] || exit 0

config=phpstan.dist.neon
[ -f phpstan.neon ] && config=phpstan.neon

echo '> PHPStan'
php -d memory_limit=2G vendor/bin/phpstan analyse -c "$config" --no-progress

echo '> deptrac'
php vendor/bin/deptrac analyse --config-file=deptrac.yaml --no-progress
