# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# The suite runs on PostgreSQL because production does. Testing repository
# queries on another engine proved to be false confidence: it forced every
# platform-specific query into a duplicate portable implementation that
# production never executed.
#
# Run `make test-db` once (after `make docker-up`) to create and migrate these
# databases. CI overrides both URLs through the workflow environment.
AUTH_DATABASE_URL="postgresql://admin:!ChangeMe!@127.0.0.1:5433/fireguard_auth_test?serverVersion=16&charset=utf8"
MAIN_DATABASE_URL="postgresql://main_admin:!ChangeMeMain!@127.0.0.1:5434/fireguard_main_test?serverVersion=16&charset=utf8"
DATABASE_STORAGE_TIMEZONE=UTC
OAUTH_ENCRYPTION_KEY='def0000040e4872e7be4ddc6fb871948cfc8354cac1d898b7c2820e461f650bfeee69121fab5b27b023b6181cbad842bf465a98'
OAUTH_ISSUER='http://localhost'
LOGIN_CLIENT_ID='a7b8c9d0-e1f2-4456-8123-789012345678'
LOGIN_CLIENT_SECRET='dev_secret_test'
ACCESS_TOKEN_TTL=3600
ACCESS_TOKEN_INCLUDE_EMAIL=false
ACCESS_TOKEN_INCLUDE_RBAC=false
AUTHZ_PERMISSION_CACHE_TTL=10
REFRESH_TOKEN_COOKIE_NAME='refresh_token'
REFRESH_TOKEN_LIFETIME_SHORT=86400
REFRESH_TOKEN_LIFETIME_LONG=2592000
TRUSTED_DEVICE_COOKIE_NAME='trusted_device'
TRUSTED_DEVICE_LIFETIME=2592000
OTP_CODE_LENGTH=6

SECURITY_LOG_INCLUDE_PII=false
SECURITY_LOG_PII_SALT=test_only_not_a_production_salt
DATA_RETENTION_DAYS=30

# Notifier configuration
ADMIN_EMAIL='admin@test.local'
SMS_DSN='null://null'
MAILER_DSN='null://null'
MAILER_FROM='no-reply@test.local'
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
MESSENGER_TRANSPORT_DSN='in-memory://'
DEFAULT_URI='https://localhost'

# Mercure hub JWT signing secret. The base template ships `change_me`, which is
# 72 bits — too short for the HS256 signer (needs >=256 bits). Provide a real
# test key so the hub token factory can sign (MercureSubscriptionTokenTtlTest).
MERCURE_JWT_SECRET='!ChangeThisMercureHubJWTSecretKeyForTests!'

# Object storage: keep the hermetic test suite on local disk (no S3/MinIO in CI).
STORAGE_DSN=local://var/storage

# Webhook signing secret encryption key (base64-encoded 32 raw bytes) + dev-only toggles
WEBHOOK_ENCRYPTION_KEY=Y2fb/M9uQKaEyN3r40yPaM+TZE3yP6ufgbeJ8jj87kc=
WEBHOOK_ALLOW_INSECURE_URLS=true
WEBHOOK_HTTP_TIMEOUT=5





###> facility/geocoding ###
# Unroutable on purpose: no test may ever reach the real Nominatim. A test
# that accidentally drives the adapter gets the fail-soft null (404), not an
# external HTTP call. The adapter's own tests use MockHttpClient instead.
GEOCODING_BASE_URL=http://127.0.0.1:1
###< facility/geocoding ###
