# GENERATED FILE — do not edit by hand.
#
# ansible/deploy.yml rewrites this file on every deployment from GitHub Actions
# variables and secrets. Anything typed here is lost on the next deploy.
#
# Which keys appear: `.env.example` (the application's declared contract) plus the
# `${VAR:?...}` entries of `compose.prod.yaml` (the Postgres identity and the image
# ref). Keys with a default in `config/packages/env_defaults.yaml` are deliberately
# absent — the application supplies them, and repeating them here would let this
# file drift from the code.
#
# To change a value: edit the GitHub Actions variable or secret and redeploy.
# To add a key: add it to `.env.example` and to the env block of
# `.github/workflows/deploy-vps.yml`, in the same pull request.
#
# Rendered {{ fireguard_deployment_timestamp }} for image {{ fireguard_image }}.
{% for key in fireguard_declared_env_keys | reject('equalto', 'FIREGUARD_IMAGE') | sort %}
{{ key }}={{ lookup('env', key) }}
{% endfor %}
FIREGUARD_IMAGE={{ fireguard_image }}
