# GENERATED FILE — do not edit by hand.
#
# ansible/deploy.yml rewrites this file on every deployment from GitHub Actions
# variables and secrets. Anything typed here is lost on the next deploy.
#
# Which keys appear: `.env.example` (the application's declared contract) plus the
# `${VAR:?...}` entries of `compose.prod.yaml` (the Postgres identity and the image
# ref). Keys with a default in `config/packages/env_defaults.yaml` are deliberately
# absent — the application supplies them, and repeating them here would let this
# file drift from the code. So are the keys compose pins in its own `environment:`
# blocks, which win over `env_file:`.
#
# To change a value: edit the GitHub Actions variable or secret and redeploy.
# To add a key: add it to `.env.example` and to the env block of
# `.github/workflows/deploy-vps.yml`, in the same pull request.
#
# EVERY VALUE IS SINGLE-QUOTED, and that is not cosmetic. This file has two
# consumers: `env_file:` in compose, which reads KEY=VALUE literally, and
# `. ./.env` in the two `Synchronize <db> database role password` tasks, which
# SOURCES it with /bin/sh. Unquoted, the `&` in
# `...?serverVersion=16&charset=utf8` backgrounds the assignment and leaves
# AUTH_DATABASE_URL empty in the current shell -- measured, and it is what broke
# the first managed deploy. `.env.example` quoted its DSNs for exactly this
# reason; generating them bare lost it.
#
# Single quotes rather than double: sh performs no expansion inside them, so a
# `$`, a backtick or a backslash in a regex or a password survives intact. A
# value containing a single quote is refused upstream by the render guard, so
# there is nothing to escape here.
#
# Rendered {{ fireguard_deployment_timestamp }} for image {{ fireguard_image }}.
{% for key in fireguard_declared_env_keys | difference(fireguard_computed_env_keys) | sort %}
{{ key }}='{{ lookup('env', key) }}'
{% endfor %}

# Computed, not supplied. The connection URL and POSTGRES_*_PASSWORD used to be two
# independent values carrying the same password, with nothing checking that they
# agreed — and disagreeing is not a failed boot: `Synchronize auth database role
# password` ALTERs the role to the URL's password while the container keeps the
# other, so the app is locked out of a database whose password it just changed.
# Deriving the URL from the parts makes that impossible, and leaves the password
# with exactly one source.
#
# The host is the compose service name; both databases listen on 5432 inside the
# network and are not published.
#
# `urlencode` alone is NOT enough: it is urllib's `quote`, whose default safe set
# is "/", so a password containing a slash comes through raw and RFC 3986 forbids
# "/" in userinfo — the authority would end early and the DSN would parse into
# something else entirely. Measured: `p@ss w/rd:1` encodes to `p%40ss%20w/rd%3A1`.
# The regex_replace closes exactly that one gap; every other character `quote`
# leaves alone is legal in userinfo.
AUTH_DATABASE_URL='postgresql://{{ lookup('env', 'POSTGRES_AUTH_USER') | urlencode | regex_replace('/', '%2F') }}:{{ lookup('env', 'POSTGRES_AUTH_PASSWORD') | urlencode | regex_replace('/', '%2F') }}@auth_database:5432/{{ lookup('env', 'POSTGRES_AUTH_DB') }}?serverVersion=16&charset=utf8'
MAIN_DATABASE_URL='postgresql://{{ lookup('env', 'POSTGRES_MAIN_USER') | urlencode | regex_replace('/', '%2F') }}:{{ lookup('env', 'POSTGRES_MAIN_PASSWORD') | urlencode | regex_replace('/', '%2F') }}@main_database:5432/{{ lookup('env', 'POSTGRES_MAIN_DB') }}?serverVersion=16&charset=utf8'
FIREGUARD_IMAGE='{{ fireguard_image }}'
