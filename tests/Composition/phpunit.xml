<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../bootstrap.php" colors="true" failOnWarning="true">
  <php>
    <ini name="memory_limit" value="1G"/>
    <server name="APP_ENV" value="test" force="true"/>
    <server name="APP_DEBUG" value="0" force="true"/>
    <server name="KERNEL_CLASS" value="Tests\Support\Kernel\CoreKernel" force="true"/>
    <server name="TEST_DB_ISOLATION" value="1" force="true"/>
    <server name="TEST_DB_RESET" value="0" force="true"/>
  </php>
  <testsuites>
    <testsuite name="Core composition">
      <file>../Architecture/Unit/CoreCompositionTest.php</file>
    </testsuite>
  </testsuites>
  <extensions>
    <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
  </extensions>
</phpunit>
