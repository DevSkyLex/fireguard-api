Dockerfile*
docker-compose*
compose*.yaml
.docker

# CI/CD
.github
.gitlab-ci.yml

# OS files
.DS_Store
Thumbs.db

# SonarQube
sonar-project.properties

# Temporary files
*.log
*.tmp
