{
  "php": {
    "command": "node",
    "args": ["C:/nvm4w/nodejs/node_modules/intelephense/lib/intelephense.js", "--stdio"],
    "extensionToLanguage": {
      ".php": "php"
    },
    "workspaceFolder": "G:/Projets/fireguard/fireguard-sso-api",
    "settings": {
      "intelephense": {
        "files": {
          "exclude": ["**/.git/**", "**/node_modules/**", "**/var/**", "**/public/bundles/**"],
          "maxSize": 3000000
        },
        "environment": {
          "phpVersion": "8.4.8"
        },
        "diagnostics": {
          "run": "onType"
        }
      }
    },
    "startupTimeout": 120000,
    "shutdownTimeout": 15000,
    "restartOnCrash": true,
    "maxRestarts": 3,
    "diagnostics": true
  }
}
